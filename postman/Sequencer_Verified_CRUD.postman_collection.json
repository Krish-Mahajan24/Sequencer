{
  "info": {
    "name": "Sequencer - Verified CRUD workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the entire collection in order. Creates a fresh test account, exercises CRUD, and deletes only that temporary account last. Do not substitute your personal account token. Sequences and history do not have PUT routes."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Health and MongoDB connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Request succeeded', () => pm.expect(result.success === false).to.eql(false));",
              "pm.test('MongoDB connected', () => pm.expect(result.database).to.eql('Connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create temporary test account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"CRUD Test\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('testEmail', 'postman-crud-' + Date.now() + '-' + pm.variables.replaceIn('{{$randomUUID}}') + '@example.com');",
              "pm.collectionVariables.set('testPassword', 'postman-test-password-123');",
              "pm.collectionVariables.set('token', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.test('Request succeeded', () => pm.expect(result.success === false).to.eql(false));",
              "pm.collectionVariables.set('token', result.token);",
              "pm.collectionVariables.set('userId', result.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
