# ==========================================
# Sequencer Backend Environment Configuration
# ==========================================

# Port the backend server listens on
PORT=5050

# Node environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster details with your Atlas credentials
# Example: mongodb+srv://dbuser:mypassword@cluster0.abcde.mongodb.net/sequencer?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sequencer?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=sequencer_jwt_secret_development_key_change_in_production

# Social sign-in (server-side credentials only)
APP_URL=http://localhost:5050/frontend
BACKEND_URL=http://localhost:5050
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
