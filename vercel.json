{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "includeFiles": "backend/views/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
